# Public configuration. These values are safe to expose. Do not put API keys here.
NEXT_PUBLIC_ROMASWAP_CHAIN_ID=8453
NEXT_PUBLIC_ROMASWAP_FEE_BPS=25
NEXT_PUBLIC_ROMASWAP_MODE=demo

# Public Reown / WalletConnect Cloud project id. Required for the QR code used by Trust Wallet, Rainbow, and other mobile wallets.
# Create one at https://cloud.reown.com and allow this site's domain.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Leave unset until the owner confirms a public treasury address.
# Never put a seed phrase or private key in this file.
# ROMASWAP_TREASURY_ADDRESS=
# ZEROX_API_KEY=
